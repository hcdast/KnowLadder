NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5174
ALLOW_INSECURE_HTTP=true
TRUST_PROXY=0
MONGODB_URI=mongodb://127.0.0.1:27017/knowladder?replicaSet=kl-dev&directConnection=true
# 拓扑：replicaSet（默认）| standalone | auto。生产必须 replicaSet。
# KL_MONGO_TOPOLOGY=replicaSet
# 非生产显式允许 standalone 事务降级 shim（无跨文档原子性）。生产禁止。
# KL_MONGO_ALLOW_STANDALONE=true

# 启动前自行生成随机密钥；故意不提供可用默认值。
AUTH_RATE_LIMIT_KEY=
SESSION_PREAUTH_MS=600000
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
SESSION_TOUCH_MS=60000
TEMPORARY_PASSWORD_MS=86400000

# 可选附件扫描。false 暂停新附件登记/上传，不校验 ClamAV 配置、不启动扫描worker。
FILE_SCAN_ENABLED=false
# 不设置开关时默认 true，保留旧部署行为；开启后须填写扫描配置。
# 路径须为仓库与 Web 根之外的绝对路径。
# Windows：须受保护的私有 DACL，且祖先可信（禁止 junction）。
# POSIX：祖先链须由 root/当前用户持有，任一目录不得 group/other 可写
# （含带 sticky 的目录，例如 /tmp）。
# 文件测试中 TEST_FILE_STORAGE_PARENT 也须满足同一边界。
FILE_STORAGE_ROOT=
CLAMSCAN_PATH=
# 由 freshclam/运维维护：官方 main 与 daily 的 CVD/CLD 容器。
# 服务不会下载病毒库；clamscan 通过加载来校验它们。
CLAMAV_DATABASE=
# ClamAV 1.5+：安装其官方 CVD 根 CA。若为用户本地引擎，
# 将 CVD_CERTS_DIR 指向该证书目录，而非系统默认路径。
# CVD_CERTS_DIR=/absolute/private/tooling/certs
# 禁止为绕过缺证书而关闭签名校验。
# 必填政策项：故意不提供生产新鲜度默认值（0 < hours <= 8760）。
SCAN_DATABASE_MAX_AGE_HOURS=
SCAN_TIMEOUT_MS=60000
# 可用字节减去本次声明上传字节后低于该值时拒绝上传。
FILE_MIN_FREE_BYTES=104857600
# 构建后的 worker 命令：npm run files:worker / files:scan / files:reconcile
# 受控、显式调度的留存清理：npm run files:cleanup
# 只读磁盘与元数据用量盘点：npm run files:usage

# 可选阶段五 LOCAL/SYNTHETIC 托管环境。登记须显式进行；
# 普通未登记 API 不意味着允许擦除、备份或恢复。
# 源库/恢复库必须是回环副本集上的专用 kl_test_*/kl_restore_*。
# 独立的 kl_control_* 权威库须放在业务恢复包之外。
# KL_ENVIRONMENT_ID=<registered UUID>
# KL_CONTROL_MONGODB_URI=mongodb://127.0.0.1:27017/kl_control_local?replicaSet=kl-dev
# 仓库外相互独立的绝对私有目录；须受保护 ACL。
# KL_SAFETY_LEDGER_ROOT=<absolute private directory>
# KL_SAFETY_LEDGER_MIRROR_ROOT=<different absolute private directory>
# 另行生成并妥善保管新的 32 字节密钥（64 位十六进制）；无可用默认值。
# KL_SAFETY_LEDGER_KEY=
# SYSTEM_BACKUP_KEY=
# 维护令牌由运维签发到私有令牌文件，切勿复制到此处。
# 中断恢复须走受控 privacy-execute / backup-run，并以进程退出为证。

# 教学培训扩展：默认关闭；仅在本地副本集、停写并完成 v11 迁移后启用。
KL_TRAINING_ENABLED=false
# AI 使用 OpenAI-compatible chat completion HTTPS URL；无配置时拒绝调用。
KL_AI_ENDPOINT=
KL_AI_MODEL=
KL_AI_API_KEY=
# 公共站点组织/咨询处理成员须为实际24hex ID，留存1至90天；缺项关闭表单。
KL_SITE_ORG_ID=
KL_SITE_HANDLER_MEMBER_ID=
KL_SITE_LEAD_RETENTION_DAYS=

# Coursework attachments require training replicaSet/v12 and real private scanner. Default off.
KL_COURSEWORK_FILES_ENABLED=false

# Optional independent v13 AI capability/currency/amount reservation policy.
KL_AI_POLICY_ENABLED=false

# Local controlled v14 report publishing; migrate only with all writers stopped.
KL_TRAINING_REPORTS_ENABLED=false

# 二期教务/路径/证书/站内通知：本地副本集受控v15迁移后方可启用
KL_TRAINING_PHASE2_ENABLED=false

# 默认关闭：AI有效学情解读依赖培训、报告与金额策略；启用前显式执行v16迁移。
KL_AI_LEARNING_REPORTS_ENABLED=false

# 授权关键词知识库：培训本地副本集停写迁移v17后启用；独立knowledge:worker更新索引。
KL_KNOWLEDGE_ENABLED=false

# 素材导入：本地副本集停写迁移v18/v19，依赖培训/知识/扫描；imports:worker解析。
# 预览编辑及共享证明已编码，浏览器/完整生命周期验收待完成；保持关闭。
KL_KNOWLEDGE_IMPORT_ENABLED=false

# Named course feedback; v20 requires stopped non-production replicaSet migration after v19.
# Leave disabled until privacy/restore/API/browser acceptance is complete.
KL_TRAINING_SURVEYS_ENABLED=false

# Recovery control schema v21. Enabling this alone does not open standalone business writes.
KL_STANDALONE_RECOVERY_ENABLED=false

# Nonproduction managed API, requires recovery schema. Unsupported writes/workers refuse.
KL_STANDALONE_MANAGED_API_ENABLED=false

# 仅非生产离线迁移时显式打开；Atlas 拒绝 collMod 的元数据保全替换。
# CLI 还须临时设置 KL_SCHEMA_REBUILD_OFFLINE=true，正常启动保持关闭。
KL_MONGO_ALLOW_COLLECTION_REBUILD=false

# File bytes: local (default) or S3-compatible. S3 still needs private scanner spool.
FILE_STORAGE_DRIVER=local
S3_ENDPOINT=https://s3.cstcloud.cn
S3_BUCKET=7cba3c577763495e966eb46664c75e9d
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PREFIX=knowladder
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FILE_SPOOL_ROOT=

# Optional trusted CA PEM for provider TLS chain; never disable TLS verification.
S3_CA_BUNDLE=
