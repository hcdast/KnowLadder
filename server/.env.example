NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5174
ALLOW_INSECURE_HTTP=true
TRUST_PROXY=0
MONGODB_URI=mongodb://127.0.0.1:27017/knowladder?replicaSet=kl-dev&directConnection=true
# Generate a fresh random secret before starting; intentionally no working default.
AUTH_RATE_LIMIT_KEY=
SESSION_PREAUTH_MS=600000
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000
SESSION_TOUCH_MS=60000
TEMPORARY_PASSWORD_MS=86400000

# Optional attachment subsystem. Missing scanner configuration disables uploads,
# not attachment-free content. Use absolute paths outside the repository/web root.
# Windows requires a protected private DACL and trusted ancestors (no junctions).
# POSIX requires root/current-user ownership and no group/other-writable directory
# anywhere in the ancestor chain (including sticky directories such as /tmp).
# For file tests, TEST_FILE_STORAGE_PARENT must meet the same boundary.
FILE_STORAGE_ROOT=
CLAMSCAN_PATH=
# Managed by freshclam/operators: official main and daily CVD/CLD containers.
# The service does not download databases; clamscan verifies them by loading them.
CLAMAV_DATABASE=
# ClamAV 1.5+: install its official CVD root CA. For a user-local engine, set
# CVD_CERTS_DIR to that certificate directory instead of the system default.
# CVD_CERTS_DIR=/absolute/private/tooling/certs
# Never disable signature verification to work around missing certificates.
# REQUIRED policy decision, intentionally no production freshness default (0 < hours <= 8760).
SCAN_DATABASE_MAX_AGE_HOURS=
SCAN_TIMEOUT_MS=60000
# Reject uploads when available bytes minus declared upload bytes falls below this.
FILE_MIN_FREE_BYTES=104857600
# Worker commands after build: npm run files:worker / files:scan / files:reconcile
# Controlled, explicitly scheduled retention cleanup: npm run files:cleanup
# Read-only disk and metadata inventory: npm run files:usage

# Optional phase-five LOCAL/SYNTHETIC managed environment. Registration is explicit;
# ordinary unregistered APIs do not imply permission to erase, back up, or restore.
# Source/restore databases must be dedicated kl_test_*/kl_restore_* on loopback replica sets.
# Keep the separate kl_control_* authority database outside business restore packages.
# KL_ENVIRONMENT_ID=<registered UUID>
# KL_CONTROL_MONGODB_URI=mongodb://127.0.0.1:27017/kl_control_local?replicaSet=kl-dev
# Independent absolute private directories outside this repository; protected ACLs required.
# KL_SAFETY_LEDGER_ROOT=<absolute private directory>
# KL_SAFETY_LEDGER_MIRROR_ROOT=<different absolute private directory>
# Generate and separately protect a fresh 32-byte key (64 hex); no working defaults.
# KL_SAFETY_LEDGER_KEY=
# SYSTEM_BACKUP_KEY=
# Maintenance tokens are issued by operations to a private token file, never copied here.
# Use controlled privacy-execute/backup-run for exit-proven interruption recovery.
